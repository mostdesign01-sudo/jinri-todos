#!/bin/bash
set -euo pipefail
URL="https://mostdesign01-sudo.github.io/jinri-todos/overlay.html"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROME_ALT="$HOME/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EDGE="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"

if [ -x "$CHROME" ]; then
  exec "$CHROME" --app="$URL"
elif [ -x "$CHROME_ALT" ]; then
  exec "$CHROME_ALT" --app="$URL"
elif [ -x "$EDGE" ]; then
  exec "$EDGE" --app="$URL"
else
  open "$URL"
fi
